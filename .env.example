# ---------------------------------------------------------------------------
# Copy to .env and fill in. NEVER commit .env - it holds device admin
# credentials that can unlock doors and read every staff PIN.
# ---------------------------------------------------------------------------

# Deployment mode. Controls how the system reaches the terminals.
#   direct = server sits in the same LAN as the terminals (on-prem)
#   agent  = server is remote/cloud; an on-site connector dials out to it
CONNECTOR_MODE=direct

# --- Database ---------------------------------------------------------------
DATABASE_URL="mysql://attendance:CHANGE_ME@127.0.0.1:3306/attendance"

# --- Test terminal ----------------------------------------------------------
# Used by `npm run probe` to verify connectivity against a real device.
HIK_HOST=https://192.168.1.250
HIK_USERNAME=admin
HIK_PASSWORD=CHANGE_ME
# Terminals ship with self-signed certificates. Set to true only for
# devices reached over an untrusted network with a proper certificate.
HIK_VERIFY_TLS=false

# --- Event ingest -----------------------------------------------------------
# The URL the terminal will POST events to. Must be reachable BY THE DEVICE.
INGEST_PORT=8080
INGEST_PUBLIC_URL=http://192.168.1.102:8080/hik/events
# Digest credentials the device uses to authenticate to our ingest endpoint.
# Device firmware limits this password to 8-16 characters.
INGEST_USERNAME=hikpush
INGEST_PASSWORD=CHANGE_ME_8_16
