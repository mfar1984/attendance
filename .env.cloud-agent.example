# ---------------------------------------------------------------------------
# Cloud + agent installation.
#
# This is the `.env` for the CLOUD side. The connector on each site has its own
# configuration, written by `install-agent.sh` into
# /etc/attendance-agent/agent.env - nothing here is read by it.
#
# A cloud host cannot route to 192.168.1.250, so every terminal on a private
# network needs a connector. Create one per site, then assign devices to it:
#
#   node --env-file=.env node_modules/tsx/dist/cli.mjs scripts/create-agent.mts "Nama Tapak"
#
# `Device.agentId` is per device and null means this server reaches the terminal
# itself, so one installation can hold a direct site and several agent sites at
# once. CONNECTOR_MODE below is only the default for newly added devices.
#
# Hikvision ISAPI only through a connector for now. See the deployment steering.
#
# Copy to `.env` ON THE SERVER and fill in. Never commit the filled copy:
# it holds the database password, the key that decrypts every door credential,
# and the secret that signs every session.
#
#   cp .env.cloud-agent.example .env && nano .env
#
# Paths below assume the cPanel layout where the subdomain folder is also the
# Node.js application root:
#
#   /home/ACCOUNT/attendance.malaysiadev.com   <- clone, application root
#   /home/ACCOUNT/attendance-data              <- uploads and dumps, outside it
#
# Replace ACCOUNT throughout.
# ---------------------------------------------------------------------------

NODE_ENV=production

# --- Topology ---------------------------------------------------------------
# `direct` = this server sits on the same LAN as the terminals.
# `agent`  = terminals are behind on-site connectors that dial out to here.
#
# A cloud host cannot reach 192.168.x.x, so a cloud install is always `agent`.
# This is the default for newly added terminals only; which connector a given
# terminal uses is recorded per device, because one cloud install can serve a
# direct site and two agent sites at once.
CONNECTOR_MODE=agent

# --- Database ---------------------------------------------------------------
# cPanel prefixes both the user and the database with the account name.
# Percent-encode any of : / ? # [ ] @ that appear in the password.
DATABASE_URL="mysql://malaysiadev_attendance:PASSWORD_HERE@127.0.0.1:3306/malaysiadev_attendance"

# --- Secrets ----------------------------------------------------------------
# Generate fresh values on the server. Do not reuse the development ones.
#   ENCRYPTION_KEY : openssl rand -hex 32
#   SESSION_SECRET : openssl rand -base64 48
#
# ENCRYPTION_KEY is not rotatable in place. It decrypts stored device passwords,
# TOTP secrets and door PINs; changing it makes every one of those unreadable.
ENCRYPTION_KEY=
SESSION_SECRET=

SESSION_TTL_HOURS=12

# On in production. An administrator account can rewrite the attendance of
# thousands of people, so a second factor is warranted.
REQUIRE_ADMIN_2FA=true

# --- Serving ----------------------------------------------------------------
# Passenger patches `listen()` and hands the app its own socket, so PORT is
# ignored under cPanel. It still matters if the app is ever run directly.
PORT=8080
HOST=127.0.0.1

# Lets one process serve the API and the built web bundle, which keeps session
# cookies same-origin and leaves one thing to restart.
WEB_DIST_DIR=/home/ACCOUNT/attendance.malaysiadev.com/apps/web/dist

# --- Background work --------------------------------------------------------
# FALSE on cPanel, and this is not a preference.
#
# Passenger stops an application that has been idle, and the in-process timers
# stop with it. The reconcile pull would then run for a few minutes after each
# visit and die, which is worse than never starting: the devices screen keeps
# showing a cursor that advanced this morning, so a pull that has been dead all
# day looks like one that is merely quiet.
#
# With this off, the same functions run from cron. See deployment steering.
RUN_WORKERS=false

# --- Event ingest -----------------------------------------------------------
# Credentials terminals use when posting events here. Device firmware limits
# this password to 8-16 characters.
#
# In agent topology, terminals post to their on-site agent and not to this URL.
# Each agent carries its own credential, so a leak at one site cannot forge
# attendance for another.
INGEST_USERNAME=hikpush
INGEST_PASSWORD=
INGEST_PUBLIC_URL=https://attendance.malaysiadev.com/hik/events

# --- This installation's own public address ----------------------------------
# Only needed when something in front rewrites Host. Leave it blank otherwise:
# the connector screen derives the address from the request the operator is
# making, which cannot go stale the way a configured value can.
#
# Do NOT reach for INGEST_PUBLIC_URL for this. That one has to name somewhere a
# TERMINAL can reach, and in this topology terminals reach their on-site agent
# and never this host - so it commonly holds a local address. Using it here
# printed an installer command pointing at loopback: a command that looks
# complete, runs, and fails on a machine in another building.
#
# An unroutable value here is refused rather than used. Loopback, link-local and
# the private ranges yield an obviously incomplete placeholder instead, because a
# placeholder gets questioned where 127.0.0.1 gets pasted.
PUBLIC_URL=

# --- Engine -----------------------------------------------------------------
SYNC_INTERVAL_SECONDS=60
CLOCK_DRIFT_WARN_SECONDS=30

# Attendance dates are computed in this zone, not the server's.
# A cloud host running UTC must still file a 01:00 night shift against the
# local work date rather than the previous UTC day.
ORG_TIMEZONE=Asia/Kuala_Lumpur

# --- Paths ------------------------------------------------------------------
# Outside the clone, so `git pull` never touches uploaded avatars or dumps and
# a redeploy cannot delete them.
STORAGE_DIR=/home/ACCOUNT/attendance-data/storage
BACKUP_DIR=/home/ACCOUNT/attendance-data/backups
