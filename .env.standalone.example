# ---------------------------------------------------------------------------
# Standalone installation.
#
# One server inside the hospital LAN, reaching the terminals itself. This is the
# shape the application defaults to: CONNECTOR_MODE, RUN_WORKERS and HOST all
# already default to the values below, so most of this file is here to be read
# rather than to change behaviour.
#
# Copy to `.env` at the repository root and fill in the four values that have no
# default. Never commit the filled copy: it holds the database password, the key
# that decrypts every door credential, and the secret that signs every session.
#
#   cp .env.standalone.example .env
#
# ---------------------------------------------------------------------------

NODE_ENV=production

# --- Topology ---------------------------------------------------------------
# `direct` = this server sits on the same LAN as the terminals and polls them.
# Nothing else is needed: no agent, no outbound tunnel, no cloud.
CONNECTOR_MODE=direct

# --- Database ---------------------------------------------------------------
# Percent-encode any of : / ? # [ ] @ that appear in the password.
DATABASE_URL="mysql://attendance:PASSWORD_HERE@127.0.0.1:3306/attendance"

# --- Secrets ----------------------------------------------------------------
# Generate fresh values on the machine that will run this. Do not reuse the
# development ones: anyone who has seen the development repo could otherwise
# sign a session here.
#
#   Linux/macOS   ENCRYPTION_KEY : openssl rand -hex 32
#                 SESSION_SECRET : openssl rand -base64 48
#
#   Windows       ENCRYPTION_KEY : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#                 SESSION_SECRET : node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
#
# ENCRYPTION_KEY is not rotatable in place. It decrypts stored device passwords,
# TOTP secrets and door PINs; changing it makes every one of those unreadable.
ENCRYPTION_KEY=
SESSION_SECRET=

SESSION_TTL_HOURS=12

# On in production. An administrator account can rewrite the attendance of
# thousands of people, so a second factor is warranted.
REQUIRE_ADMIN_2FA=true

# --- Serving ----------------------------------------------------------------
PORT=8080

# The terminals have to reach this server to post events, so it cannot bind
# loopback only.
#
# Prefer the machine's own LAN address over 0.0.0.0. Binding every interface on
# a host that also has a second NIC, a VPN, or a WiFi adapter publishes the API
# on all of them, and the narrower bind is one word shorter to write.
#
# Traffic on this port is plain HTTP: session cookies and the ingest credential
# cross the LAN in the clear. Put the terminals and this server on their own
# VLAN, or terminate TLS in front and point the terminals at that.
HOST=192.168.1.10

# Lets one process serve the API and the built web bundle, which keeps session
# cookies same-origin and leaves one thing to restart. Must be absolute.
WEB_DIST_DIR=/opt/attendance/apps/web/dist

# --- Background work --------------------------------------------------------
# TRUE here, and this is the whole advantage of standalone.
#
# The process runs continuously, so the reconcile pull, retention sweep and
# backup schedule live in it. No crontab to keep in agreement with the settings
# screen, and the clock gates stay in policy where an operator can see them.
RUN_WORKERS=true

# --- Event ingest -----------------------------------------------------------
# Credentials the terminals use when posting events here. Device firmware limits
# this password to 8-16 characters.
#
# INGEST_PUBLIC_URL is what gets written into each terminal's HTTP listener
# config, so it must be the address the terminal can reach - this server's LAN
# address, not a public hostname and not localhost.
INGEST_USERNAME=hikpush
INGEST_PASSWORD=
INGEST_PUBLIC_URL=http://192.168.1.10:8080/hik/events

# --- Engine -----------------------------------------------------------------
SYNC_INTERVAL_SECONDS=60
CLOCK_DRIFT_WARN_SECONDS=30

# Attendance dates are computed in this zone, not the server's. Left explicit
# even when the machine is already on Malaysian time, because a server whose
# clock is corrected to UTC later must not silently start filing night shifts
# against the previous day.
ORG_TIMEZONE=Asia/Kuala_Lumpur

# --- Paths ------------------------------------------------------------------
# Outside the clone, so `git pull` never touches uploaded avatars or dumps and
# a redeploy cannot delete them. Absolute paths.
STORAGE_DIR=/var/lib/attendance/storage
BACKUP_DIR=/var/lib/attendance/backups
