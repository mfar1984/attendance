# ---------------------------------------------------------------------------
# Production environment template.
#
# Copy to `.env` ON THE SERVER and fill in. Never commit the filled copy:
# it holds the database password, the key that decrypts every door credential,
# and the secret that signs every session.
#
#   cp .env.production.example .env
#   nano .env
#
# ---------------------------------------------------------------------------

NODE_ENV=production

# --- Topology ---------------------------------------------------------------
# `direct` = this server sits on the same LAN as the terminals.
# `agent`  = terminals are behind on-site connectors that dial out to here.
#
# This is the default for newly added terminals only. Which connector a given
# terminal actually uses is recorded per device, because one cloud install can
# serve a direct site and two agent sites at once.
CONNECTOR_MODE=agent

# --- Database ---------------------------------------------------------------
# cPanel prefixes both the user and the database with the account name.
# Percent-encode any of : / ? # [ ] @ that appear in the password.
DATABASE_URL="mysql://malaysiadev_attendance:PASSWORD_HERE@127.0.0.1:3306/malaysiadev_attendance"

# --- Secrets ----------------------------------------------------------------
# Generate fresh values on the server. Do not reuse the development ones.
#   ENCRYPTION_KEY : openssl rand -hex 32
#   SESSION_SECRET : openssl rand -base64 48
#
# ENCRYPTION_KEY is not rotatable in place. It decrypts stored device passwords,
# TOTP secrets and door PINs; changing it makes every one of those unreadable.
ENCRYPTION_KEY=
SESSION_SECRET=

SESSION_TTL_HOURS=12

# On in production. An administrator account can rewrite the attendance of
# thousands of people, so a second factor is warranted.
REQUIRE_ADMIN_2FA=true

# --- Serving ----------------------------------------------------------------
# Bound to loopback because the reverse proxy terminates TLS in front of it.
# Binding 0.0.0.0 on a public host exposes the API without TLS.
PORT=8080
HOST=127.0.0.1

# Lets one process serve the API and the built web bundle, which keeps session
# cookies same-origin and leaves one thing to restart.
WEB_DIST_DIR=/home/USER/attendance-production/apps/web/dist

# --- Event ingest -----------------------------------------------------------
# Credentials terminals use when posting events here. Device firmware limits
# this password to 8-16 characters.
#
# In agent topology, terminals post to their on-site agent and not to this URL.
# Each agent carries its own credential, so a leak at one site cannot forge
# attendance for another.
INGEST_USERNAME=hikpush
INGEST_PASSWORD=
INGEST_PUBLIC_URL=https://attendance.malaysiadev.com/hik/events

# --- Engine -----------------------------------------------------------------
SYNC_INTERVAL_SECONDS=60
CLOCK_DRIFT_WARN_SECONDS=30

# Attendance dates are computed in this zone, not the server's.
# A cloud host running UTC must still file a 01:00 night shift against the
# local work date rather than the previous UTC day.
ORG_TIMEZONE=Asia/Kuala_Lumpur

# --- Paths ------------------------------------------------------------------
# Outside the clone, so `git pull` never touches uploaded avatars or dumps and
# a redeploy cannot delete them.
STORAGE_DIR=/home/USER/attendance-data/storage
BACKUP_DIR=/home/USER/attendance-data/backups
